# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# BotFather dan olingan Telegram Bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Bosh administratorlar Telegram ID lari (bitta yoki vergul bilan ajratilgan: 12345678,87654321)
ADMIN_IDS=5061909214

# ==============================================================================
# Telegram Kanallar Konfiguratsiyasi
# ==============================================================================
# 1. Asosiy ommaviy kanal username si (kino xabarlari ostida "Kanalimiz: @..." va /help da chiqadi)
MAIN_CHANNEL_USERNAME=movies_reel

# 2. Kino ombori (baza) kanali ID si (Bot yangi yuklangan video/fayllarni avtomatik shu kanaldan oladi)
# Bot bu kanalda administrator bo'lishi shart! (Masalan: -1001234567890)
MOVIE_CHANNEL_ID=-1001234567890

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=moviesbot_db
DB_HOST=localhost
DB_PORT=5433
DB_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5433/moviesbot_db

# Ma'lumotlar bazasi pool sozlamalari
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# ==============================================================================
# Redis Configuration (Kesh, tezkor tekshiruvlar va 24h ko'rish cheklovlari uchun)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Ilova Sozlamalari (Application Settings)
# ==============================================================================
# Dasturlash rejimi (Ishlab chiqishda True, productionda False)
DEBUG=False

# Standart bot tili (uz, ru, en)
DEFAULT_LANGUAGE=uz

# Loglar darajasi (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
